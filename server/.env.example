# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# MongoDB Atlas connection string (replace <user>, <password>, <cluster> and <dbname>)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Port the API listens on (Render/Heroku will set PORT automatically)
PORT=5000

# The URL of your deployed front-end (used to restrict CORS in production).
# For local development the default Vite origin http://localhost:5173 is allowed.
CLIENT_URL=http://localhost:5173
